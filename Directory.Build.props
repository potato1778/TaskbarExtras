<Project>

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <Product>TaskbarExtras</Product>
    <Version>0.1.0</Version>
    <Authors>potato1778</Authors>
    <Description>Restore the Windows 10 style taskbar context menu on Windows 11 — without injecting into explorer.exe.</Description>
    <RepositoryUrl>https://github.com/potato1778/TaskbarExtras</RepositoryUrl>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
