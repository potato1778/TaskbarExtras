<Project>

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <Product>TaskbarExtras</Product>
    <Version>0.1.0</Version>
    <Authors>potato1778</Authors>
    <Description>Restore the Windows 10 style taskbar context menu on Windows 11 — without injecting into explorer.exe.</Description>
    <RepositoryUrl>https://github.com/potato1778/TaskbarExtras</RepositoryUrl>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Framework-dependent builds otherwise demand the exact major version (9.0) and refuse to
      start on a machine that only has 10.x. That is not a theoretical problem: installing the
      .NET SDK with scoop sets a USER-level DOTNET_ROOT pointing at the SDK directory, and an
      SDK bundle ships Microsoft.WindowsDesktop.App for the SDK's own version only. The apphost
      honours DOTNET_ROOT and does NOT fall back to the machine-wide install, so the app dies
      with "You must install or update .NET to run this application" on a machine that plainly
      has the runtime. Rolling forward on major removes that whole failure mode.
      The real distribution answer is still a self-contained publish - see README.
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

</Project>
