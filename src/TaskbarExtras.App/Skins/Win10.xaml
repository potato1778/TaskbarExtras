<!--
  Win10 skin — opt in by selecting the win10 skin on the command line.

  Matches the Windows 10 taskbar context menu: flat #F2F2F2 panel, almost square corners,
  tighter rows, and the light blue hover fill that Windows 10 used for menu items.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Metrics -->
  <sys:Double x:Key="MenuItemHeight">28</sys:Double>
  <Thickness x:Key="MenuPadding">2</Thickness>
  <Thickness x:Key="MenuItemPadding">10,0,24,0</Thickness>
  <CornerRadius x:Key="MenuCornerRadius">2</CornerRadius>
  <Thickness x:Key="MenuBorderMargin">6</Thickness>
  <sys:Double x:Key="MenuFontSize">12.5</sys:Double>

  <!-- Brushes: Windows 10 flat / light -->
  <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="MenuBorderBrush" Color="#C8C8C8" />
  <SolidColorBrush x:Key="MenuItemForegroundBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#D9E8F7" />
  <SolidColorBrush x:Key="MenuItemDisabledBrush" Color="#9A9A9A" />
  <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#DCDCDC" />

  <DropShadowEffect x:Key="MenuShadowEffect"
                    BlurRadius="10" ShadowDepth="2" Direction="270"
                    Opacity="0.22" Color="#000000" />

  <Style x:Key="MenuBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MenuCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource MenuPadding}" />
    <Setter Property="Margin" Value="{StaticResource MenuBorderMargin}" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Effect" Value="{StaticResource MenuShadowEffect}" />
  </Style>

  <Style x:Key="MenuTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="{StaticResource MenuFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource MenuItemForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MenuSeparatorStyle" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{StaticResource MenuSeparatorBrush}" />
    <Setter Property="Margin" Value="6,3,6,3" />
  </Style>

  <!-- One menu row. Windows 10 hover fills the full row width, with square-ish corners. -->
  <Style x:Key="MenuItemBorderStyle" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Padding" Value="{StaticResource MenuItemPadding}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource MenuItemHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
