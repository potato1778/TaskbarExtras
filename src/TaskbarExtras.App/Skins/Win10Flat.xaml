<!--
  Win10Flat skin.

  A skin is DATA, not code. Everything the menu looks like lives here, so adding a
  Windows 7 Aero or XP Luna skin later means adding another ResourceDictionary - no C#
  changes. See docs/DESIGN.md §7.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Metrics -->
  <sys:Double x:Key="MenuItemHeight" xmlns:sys="clr-namespace:System;assembly=System.Runtime">32</sys:Double>
  <Thickness x:Key="MenuPadding">4</Thickness>
  <Thickness x:Key="MenuItemPadding">12,0,28,0</Thickness>
  <CornerRadius x:Key="MenuCornerRadius">6</CornerRadius>

  <!-- Brushes: Windows 10 flat / light -->
  <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="MenuBorderBrush" Color="#C8C8C8" />
  <SolidColorBrush x:Key="MenuItemForegroundBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#D9E8F7" />
  <SolidColorBrush x:Key="MenuItemDisabledBrush" Color="#9A9A9A" />
  <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#DCDCDC" />

  <Style x:Key="MenuBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MenuCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource MenuPadding}" />
  </Style>

  <Style x:Key="MenuTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MenuItemForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MenuSeparatorStyle" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{StaticResource MenuSeparatorBrush}" />
    <Setter Property="Margin" Value="8,4,8,4" />
  </Style>

  <!-- One menu row. The whole look of the menu is this template. -->
  <Style x:Key="MenuItemBorderStyle" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Padding" Value="{StaticResource MenuItemPadding}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource MenuItemHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
