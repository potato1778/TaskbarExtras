<!--
  Win11 skin — the DEFAULT.

  Matches the Windows 11 context menu: near-white card, generous corner radius, soft drop
  shadow, and a neutral grey hover fill. It is the default because the menu is drawn on a
  Windows 11 desktop and should look like it belongs there; the Win10 look is opt-in via the
  skin command line argument.

  A skin is DATA, not code. Everything the menu looks like lives here, so a Win7 Aero or
  XP Luna skin is another file like this one. See docs/DESIGN.md §7.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Metrics -->
  <sys:Double x:Key="MenuItemHeight">34</sys:Double>
  <Thickness x:Key="MenuPadding">4</Thickness>
  <Thickness x:Key="MenuItemPadding">12,0,28,0</Thickness>
  <CornerRadius x:Key="MenuCornerRadius">8</CornerRadius>
  <!-- Width of the tick column on checkable rows. Present on every row so labels line up. -->
  <sys:Double x:Key="MenuTickColumnWidth">18</sys:Double>
  <!-- Windows 11 context menus carry no bracketed shortcut letters. The keys still work; the
       hint is simply not shown, which is what Windows 11 does too. -->
  <sys:Boolean x:Key="MenuShowMnemonics">False</sys:Boolean>
  <!-- Transparent room around the card for the drop shadow. The window is this much bigger than
       the visible menu, which is why ClassicMenuWindow reads this value back when positioning. -->
  <Thickness x:Key="MenuBorderMargin">8</Thickness>
  <sys:Double x:Key="MenuFontSize">13</sys:Double>

  <!-- Brushes -->
  <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F9F9F9" />
  <SolidColorBrush x:Key="MenuBorderBrush" Color="#E5E5E5" />
  <SolidColorBrush x:Key="MenuItemForegroundBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#E8E8E8" />
  <SolidColorBrush x:Key="MenuItemDisabledBrush" Color="#9A9A9A" />
  <!-- Group label ("Appearance"). Dimmer than a normal row, and deliberately not themed as a
       disabled entry — it is a caption, not something that failed to become available. -->
  <SolidColorBrush x:Key="MenuHeadingBrush" Color="#6E6E6E" />
  <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#E5E5E5" />

  <DropShadowEffect x:Key="MenuShadowEffect"
                    BlurRadius="16" ShadowDepth="3" Direction="270"
                    Opacity="0.30" Color="#000000" />

  <Style x:Key="MenuBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MenuCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource MenuPadding}" />
    <Setter Property="Margin" Value="{StaticResource MenuBorderMargin}" />
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="Effect" Value="{StaticResource MenuShadowEffect}" />
  </Style>

  <Style x:Key="MenuTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="{StaticResource MenuFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource MenuItemForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MenuSeparatorStyle" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{StaticResource MenuSeparatorBrush}" />
    <Setter Property="Margin" Value="8,4,8,4" />
  </Style>

  <!-- One menu row. Windows 11 uses a rounded hover fill inset from the card edge. -->
  <Style x:Key="MenuItemBorderStyle" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Padding" Value="{StaticResource MenuItemPadding}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Margin" Value="2,0,2,0" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource MenuItemHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
