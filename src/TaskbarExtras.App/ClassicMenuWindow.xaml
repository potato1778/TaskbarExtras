<Window x:Class="TaskbarExtras.App.ClassicMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarExtras"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

  <Border Style="{StaticResource MenuBorderStyle}" MinWidth="240">
    <ItemsControl x:Name="ItemsHost">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Rectangle x:Name="Sep"
                       Style="{StaticResource MenuSeparatorStyle}"
                       Visibility="Collapsed" />
            <Border x:Name="Row"
                    Style="{StaticResource MenuItemBorderStyle}"
                    MouseLeftButtonUp="OnItemMouseUp">
              <StackPanel Orientation="Horizontal">
                <!-- Reserved tick column, present on every row so labels stay aligned. Width comes
                     from the skin, like every other metric. -->
                <TextBlock Text="{Binding CheckGlyph}"
                           Style="{StaticResource MenuTextStyle}"
                           Width="{StaticResource MenuTickColumnWidth}" />
                <TextBlock x:Name="Label"
                           Style="{StaticResource MenuTextStyle}"
                           Text="{Binding DisplayName}" />
              </StackPanel>
            </Border>
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
              <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Sep" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- A group label: dimmed, no hover fill, not clickable. Dimming via the label's
                 foreground rather than the row's Opacity so it does not read as a disabled
                 action the user is being denied. -->
            <DataTrigger Binding="{Binding IsHeading}" Value="True">
              <Setter TargetName="Label" Property="Foreground" Value="{StaticResource MenuHeadingBrush}" />
              <Setter TargetName="Row" Property="IsHitTestVisible" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
              <Setter TargetName="Row" Property="IsEnabled" Value="False" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
