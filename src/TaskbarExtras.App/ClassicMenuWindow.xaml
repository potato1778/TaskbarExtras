<Window x:Class="TaskbarExtras.App.ClassicMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarExtras"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">

  <Border Style="{StaticResource MenuBorderStyle}" MinWidth="240">
    <ItemsControl x:Name="ItemsHost">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Rectangle x:Name="Sep"
                       Style="{StaticResource MenuSeparatorStyle}"
                       Visibility="Collapsed" />
            <Border x:Name="Row"
                    Style="{StaticResource MenuItemBorderStyle}"
                    MouseLeftButtonUp="OnItemMouseUp">
              <TextBlock x:Name="Label"
                         Style="{StaticResource MenuTextStyle}"
                         Text="{Binding DisplayName}" />
            </Border>
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
              <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Sep" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
              <Setter TargetName="Row" Property="IsEnabled" Value="False" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
