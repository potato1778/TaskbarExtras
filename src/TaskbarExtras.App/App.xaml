<Application x:Class="TaskbarExtras.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Swapping this one line is how a different skin gets applied. The skin argument
             picks the file before the menu window is constructed, because StaticResource
             resolves at load time. -->
        <ResourceDictionary Source="Skins/Win11.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
